{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "ctf-customer",
  "share": "disabled",
  "permission": {
    "external_directory": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "mcp": {
    "aixctf-challenge": {
      "type": "remote",
      "url": "{env:CHALLENGE_API_ENDPOINT}/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:TEAM_AGENT_KEY}"
      },
      "timeout": 30000
    },
    "chrome": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "chrome-devtools-mcp@latest"],
      "timeout": 120000
    },
    "ghidra": {
      "type": "local",
      "command": ["cmd", "/c", "uvx", "pyghidra-mcp", "--transport", "stdio", "--project-path", "ghidra-projects"],
      "timeout": 180000
    }
  },
  "agent": {
    "ctf-customer": {
      "description": "CTF 用户接口人。与用户聊天、汇报比赛进度、把用户指令写入 state/REQUESTS.md 供 CTF-Master 执行。",
      "mode": "primary",
      "prompt": "{file:./prompts/ctf-customer.md}",
      "tools": {
        "aixctf-challenge_submit_flag": false,
        "aixctf-challenge_start_challenge": false,
        "aixctf-challenge_stop_challenge": false,
        "aixctf-challenge_view_hint": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "ctf-master": {
      "description": "CTF 比赛总指挥。维护全局状态，以独立进程方式派发/续跑 ctf-worker，统一仲裁动态环境。",
      "mode": "primary",
      "prompt": "{file:./prompts/ctf-master.md}",
      "permission": {
        "task": "deny"
      }
    },
    "ctf-worker": {
      "description": "CTF 解题专家（pwn/web）。在题目专属目录 work/<id>/ 中以持续会话工作：本地分析、写 exploit、远程攻击并提交 flag。",
      "mode": "primary",
      "prompt": "{file:./prompts/ctf-worker.md}",
      "tools": {
        "aixctf-challenge_start_challenge": false,
        "aixctf-challenge_stop_challenge": false,
        "aixctf-challenge_view_hint": false
      },
      "permission": {
        "task": "deny"
      }
    }
  }
}
